# Copy to .env and fill in, Docker Compose reads .env automatically

# The stack pulls `ghcr.io/xenago/limesurvey:latest` by default.
# A specific version can be pinned, or perform a local build:
#LIMESURVEY_IMAGE=ghcr.io/xenago/limesurvey:7.0.11-260821
#LIMESURVEY_IMAGE=limesurvey:local
# Store persistent data at an absolute path (default: ./data beside the compose file):
#LS_DATA_DIR=/srv/limesurvey/data

# Initial admin, used to auto-install an empty database
# Leave LS_ADMIN_PASSWORD blank to skip
LS_ADMIN_PASSWORD=
LS_ADMIN_USER=admin
LS_ADMIN_NAME=Administrator
LS_ADMIN_EMAIL=admin@example.com

# Database (created on first start; must match config.php)
MARIADB_DATABASE=limesurvey_db
MARIADB_USER=limesurvey
MARIADB_PASSWORD=CHANGE-ME-SET-CUSTOM-limesurvey-DB-USER-PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE-ME-SET-CUSTOM-root-DB-USER-PASSWORD

# Optional container runtime options
# Set timezone applied to PHP and logs:
#TZ=Etc/UTC
# Trusted reverse-proxy IP or CIDR (e.g. 10.0.0.5 or 10.0.0.0/8)
# The client IP is read from X-Forwarded-For
#LS_PROXY_IP=

# Advanced: disable bundled services
#LS_SERVICE_CRON=1
#LS_SERVICE_NGINX=1
#LS_SERVICE_PHP=1
#LS_SERVICE_RSYSLOG=1
